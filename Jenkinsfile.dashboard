```groovy
pipeline {
    agent any

    options {
        disableConcurrentBuilds()
        timestamps()
        buildDiscarder(logRotator(numToKeepStr: '20'))
    }

    environment {
        IMAGE_NAME = 'industrial-maintenance-dashboard'
        DOCKERHUB_NAMESPACE = 'nachiket1'
        K8S_NAMESPACE = 'capstone'
        K8S_DEPLOYMENT = 'maintenance-dashboard'
        K8S_CONTAINER = 'maintenance-dashboard'
        KUBECONFIG_PATH = '/var/lib/jenkins/kubeconfig'
    }

    stages {
        stage('Validate and test') {
            steps {
                sh '''
                    set -eu

                    echo "=== Python environment ==="
                    python3 --version
                    python3 -m venv .venv-ci
                    . .venv-ci/bin/activate

                    python -m pip install --upgrade pip
                    python -m pip install -r requirements.txt

                    echo "=== Compile application ==="
                    python -m compileall -q app wsgi.py

                    echo "=== Configure Python import path ==="
                    export PYTHONPATH="${WORKSPACE}${PYTHONPATH:+:${PYTHONPATH}}"

                    echo "=== Verify application import ==="
                    python -c "import app; print('Application import OK:', app.__file__); assert hasattr(app, 'create_app')"

                    echo "=== Run test suite ==="
                    python -m pytest -q
                '''
            }
        }

        stage('Build and push dashboard image') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'dockerhub',
                        usernameVariable: 'DOCKERHUB_USER',
                        passwordVariable: 'DOCKERHUB_TOKEN'
                    )
                ]) {
                    sh '''
                        set -eu
                        set +x

                        if [ "$DOCKERHUB_USER" != "$DOCKERHUB_NAMESPACE" ]; then
                            echo "ERROR: Docker Hub username does not match DOCKERHUB_NAMESPACE."
                            exit 1
                        fi

                        FULL_IMAGE="${DOCKERHUB_NAMESPACE}/${IMAGE_NAME}"
                        TAG="${BUILD_NUMBER}"

                        echo "=== Build dashboard image ==="
                        docker build --pull \
                            --file Dockerfile \
                            --tag "${FULL_IMAGE}:${TAG}" \
                            --tag "${FULL_IMAGE}:latest" \
                            .

                        echo "=== Authenticate with Docker Hub ==="
                        printf '%s' "$DOCKERHUB_TOKEN" |
                            docker login \
                                --username "$DOCKERHUB_USER" \
                                --password-stdin

                        trap 'docker logout >/dev/null 2>&1 || true' EXIT

                        echo "=== Push versioned image ==="
                        docker push "${FULL_IMAGE}:${TAG}"

                        echo "=== Push latest image ==="
                        docker push "${FULL_IMAGE}:latest"

                        echo "Published ${FULL_IMAGE}:${TAG}"
                    '''
                }
            }
        }

        stage('Verify Kubernetes access') {
            steps {
                sh '''
                    set -eu

                    echo "=== Check Kubernetes configuration ==="
                    test -r "${KUBECONFIG_PATH}"

                    echo "=== Verify deployment permissions ==="
                    kubectl --kubeconfig="${KUBECONFIG_PATH}" \
                        auth can-i get deployments -n "${K8S_NAMESPACE}"

                    kubectl --kubeconfig="${KUBECONFIG_PATH}" \
                        auth can-i patch deployments -n "${K8S_NAMESPACE}"

                    kubectl --kubeconfig="${KUBECONFIG_PATH}" \
                        auth can-i watch deployments -n "${K8S_NAMESPACE}"

                    echo "=== Verify existing deployment ==="
                    kubectl --kubeconfig="${KUBECONFIG_PATH}" \
                        -n "${K8S_NAMESPACE}" \
                        get deployment "${K8S_DEPLOYMENT}"
                '''
            }
        }

        stage('Deploy dashboard to Kubernetes') {
            steps {
                sh '''
                    set -eu

                    FULL_IMAGE="${DOCKERHUB_NAMESPACE}/${IMAGE_NAME}:${BUILD_NUMBER}"

                    echo "=== Update existing dashboard Deployment ==="
                    kubectl --kubeconfig="${KUBECONFIG_PATH}" \
                        -n "${K8S_NAMESPACE}" \
                        set image \
                        "deployment/${K8S_DEPLOYMENT}" \
                        "${K8S_CONTAINER}=${FULL_IMAGE}"

                    echo "=== Wait for rollout ==="
                    kubectl --kubeconfig="${KUBECONFIG_PATH}" \
                        -n "${K8S_NAMESPACE}" \
                        rollout status \
                        "deployment/${K8S_DEPLOYMENT}" \
                        --timeout=180s

                    echo "=== Confirm deployed image and replicas ==="
                    kubectl --kubeconfig="${KUBECONFIG_PATH}" \
                        -n "${K8S_NAMESPACE}" \
                        get deployment "${K8S_DEPLOYMENT}" \
                        -o wide

                    echo "Dashboard rollout completed for ${FULL_IMAGE}"
                '''
            }
        }
    }

    post {
        always {
            sh '''
                if [ -d .venv-ci ]; then
                    rm -rf .venv-ci
                fi
            '''
            echo 'Dashboard pipeline finished. Azure IoT bridge pipeline was not modified.'
        }

        success {
            echo 'SUCCESS: Tests, image build, image push, and dashboard rollout completed.'
        }

        failure {
            echo 'FAILURE: Inspect the first failed stage in Console Output before retrying.'
        }
    }
}
```
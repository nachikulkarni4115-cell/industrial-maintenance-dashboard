
pipeline {
    agent any

    options {
        timestamps()
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '20'))
    }

    environment {
        IMAGE_NAME = 'nachiket1/industrial-maintenance-dashboard'
        K8S_NAMESPACE = 'capstone'
        K8S_DEPLOYMENT = 'maintenance-dashboard'
        K8S_CONTAINER = 'maintenance-dashboard'
        KUBECONFIG_PATH = '/var/lib/jenkins/kubeconfig'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
                echo 'Source code checkout completed.'
            }
        }

        stage('Install and Test') {
            steps {
                sh '''
                    set -eu

                    python3 -m venv .venv-ci
                    . .venv-ci/bin/activate

                    python -m pip install --upgrade pip
                    python -m pip install -r requirements.txt

                    export PYTHONPATH="$WORKSPACE${PYTHONPATH:+:$PYTHONPATH}"

                    python -c "from app import create_app; print('Application import successful')"

                    python -m compileall -q app wsgi.py
                    python -m pytest -q
                '''
            }
        }

        stage('Build and Push Image') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'dockerhub',
                        usernameVariable: 'DOCKER_USER',
                        passwordVariable: 'DOCKER_TOKEN'
                    )
                ]) {
                    sh '''
                        set -eu
                        set +x

                        IMAGE_TAG="${IMAGE_NAME}:${BUILD_NUMBER}"

                        printf '%s' "$DOCKER_TOKEN" |
                            docker login \
                                --username "$DOCKER_USER" \
                                --password-stdin

                        trap 'docker logout >/dev/null 2>&1 || true' EXIT

                        docker build \
                            --tag "$IMAGE_TAG" \
                            --tag "${IMAGE_NAME}:latest" \
                            .

                        docker push "$IMAGE_TAG"
                        docker push "${IMAGE_NAME}:latest"

                        echo "Published $IMAGE_TAG"
                    '''
                }
            }
        }

        stage('Deploy to Kubernetes') {
            steps {
                sh '''
                    set -eu

                    test -r "$KUBECONFIG_PATH"

                    kubectl --kubeconfig="$KUBECONFIG_PATH" \
                        get deployment "$K8S_DEPLOYMENT" \
                        -n "$K8S_NAMESPACE"

                    kubectl --kubeconfig="$KUBECONFIG_PATH" \
                        set image \
                        "deployment/$K8S_DEPLOYMENT" \
                        "$K8S_CONTAINER=${IMAGE_NAME}:${BUILD_NUMBER}" \
                        -n "$K8S_NAMESPACE"

                    kubectl --kubeconfig="$KUBECONFIG_PATH" \
                        rollout status \
                        "deployment/$K8S_DEPLOYMENT" \
                        -n "$K8S_NAMESPACE" \
                        --timeout=180s

                    kubectl --kubeconfig="$KUBECONFIG_PATH" \
                        get deployment "$K8S_DEPLOYMENT" \
                        -n "$K8S_NAMESPACE"
                '''
            }
        }
    }

    post {
        always {
            sh '''
                if [ -d .venv-ci ]; then
                    rm -rf .venv-ci
                fi
            '''
            echo 'Dashboard pipeline finished.'
        }

        success {
            echo 'SUCCESS: Dashboard tests, image publishing, and deployment completed.'
        }

        failure {
            echo 'FAILED: Check Console Output for the first failing stage.'
        }
    }
}

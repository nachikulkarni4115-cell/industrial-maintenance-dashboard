
pipeline {
    agent any

    options {
        disableConcurrentBuilds()
        timestamps()
        buildDiscarder(logRotator(numToKeepStr: '20'))
    }

    environment {
        IMAGE_NAME = 'industrial-maintenance-dashboard'
        DOCKERHUB_NAMESPACE = 'nachiket1'
        K8S_NAMESPACE = 'capstone'
        K8S_DEPLOYMENT = 'maintenance-dashboard'
        K8S_CONTAINER = 'maintenance-dashboard'
        KUBECONFIG_PATH = '/var/lib/jenkins/kubeconfig'
    }

    stages {
        stage('Validate and test') {
            steps {
                sh '''set -eu
python3 -m venv .venv-ci
. .venv-ci/bin/activate
python -m pip install --upgrade pip
python -m pip install -r requirements.txt
python -m compileall -q app wsgi.py
pytest -q
'''
            }
        }

        stage('Build and push dashboard image') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'dockerhub',
                    usernameVariable: 'DOCKERHUB_USER',
                    passwordVariable: 'DOCKERHUB_TOKEN'
                )]) {
                    sh '''set -eu
set +x

if [ "$DOCKERHUB_USER" != "$DOCKERHUB_NAMESPACE" ]; then
    echo "Docker Hub username does not match the configured namespace."
    exit 1
fi

FULL_IMAGE="${DOCKERHUB_NAMESPACE}/${IMAGE_NAME}"
TAG="${BUILD_NUMBER}"

docker build --pull \
    --file Dockerfile \
    --tag "${FULL_IMAGE}:${TAG}" \
    --tag "${FULL_IMAGE}:latest" \
    .

printf '%s' "$DOCKERHUB_TOKEN" |
    docker login \
        --username "$DOCKERHUB_USER" \
        --password-stdin

trap 'docker logout >/dev/null 2>&1 || true' EXIT

docker push "${FULL_IMAGE}:${TAG}"
docker push "${FULL_IMAGE}:latest"

echo "Published ${FULL_IMAGE}:${TAG}"
'''
                }
            }
        }

        stage('Deploy dashboard to Kubernetes') {
            steps {
                sh '''set -eu

FULL_IMAGE="${DOCKERHUB_NAMESPACE}/${IMAGE_NAME}:${BUILD_NUMBER}"

# Jenkins runs kubectl directly as the Jenkins service account.
# No sudo permissions are required.

kubectl --kubeconfig="${KUBECONFIG_PATH}" \
    -n "${K8S_NAMESPACE}" set image \
    "deployment/${K8S_DEPLOYMENT}" \
    "${K8S_CONTAINER}=${FULL_IMAGE}"

kubectl --kubeconfig="${KUBECONFIG_PATH}" \
    -n "${K8S_NAMESPACE}" rollout status \
    "deployment/${K8S_DEPLOYMENT}" \
    --timeout=180s

kubectl --kubeconfig="${KUBECONFIG_PATH}" \
    -n "${K8S_NAMESPACE}" get deployment \
    "${K8S_DEPLOYMENT}"

echo "Dashboard rollout completed for ${FULL_IMAGE}"
'''
            }
        }
    }

    post {
        always {
            sh 'rm -rf .venv-ci'
            echo 'Dashboard pipeline finished. Bridge pipeline was not modified.'
        }

        success {
            echo 'Tests, image build, push, and rollout succeeded.'
        }

        failure {
            echo 'Pipeline failed. Inspect the failing stage before retrying.'
        }
    }
}

# Copy to .env and fill real values. Never commit .env.
FLASK_CONFIG=production
SECRET_KEY=replace-with-long-random-string
DATABASE_URL=sqlite:////data/maintenance.db
INGESTION_TOKEN=replace-with-strong-ingestion-token
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=replace-with-strong-password
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
PUBLIC_DEMO_ENABLED=true
STALE_TELEMETRY_HOURS=24
SESSION_COOKIE_SECURE=true

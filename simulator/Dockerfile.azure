FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

COPY requirements-azure.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

COPY azure_iot_simulator.py ./azure_iot_simulator.py

RUN useradd --system --uid 10001 --no-create-home simulator
USER 10001

CMD ["python", "-u", "azure_iot_simulator.py"]
